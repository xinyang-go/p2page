[Unit]
Description=P2Page intranet agent
Wants=network-online.target
After=network-online.target

[Service]
User=p2page
Group=p2page
ExecStart=/usr/local/bin/p2page client -config /etc/p2page/client.json
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Pion uses Linux route netlink to enumerate interfaces for ICE.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
